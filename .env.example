DISCORD_TOKEN=вставьте_новый_токен_бота
OWNER_ID=ваш_discord_user_id

# Веб-панель (/panel). Порт — из вкладки Network на хостинге.
# WEB_PANEL_URL — адрес, по которому панель открывается из браузера.
WEB_PANEL_PORT=
WEB_PANEL_URL=http://IP_СЕРВЕРА:ПОРТ
# Куда сохранять картинки, загруженные через панель (необязательно)
# WEB_PANEL_ASSETS=panel_assets

# Путь к базе (необязательно; по умолчанию bot.db в папке запуска)
# DATABASE_PATH=bot.db

# Лого-генератор (/logo) — Hugging Face Inference Providers
HF_TOKEN=
# LOGO_PROVIDER=fal-ai
# LOGO_TEXT_MODEL=black-forest-labs/FLUX.1-dev
# LOGO_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# LOGO_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# LOGO_BG_MODEL=briaai/RMBG-2.0
# LOGO_DIR=logo_files
# LOGO_HOURLY_LIMIT=10

# Часовой пояс для расписания и {date}/{time}
# TIMEZONE=Europe/Moscow
# Триггеры по ключевым словам: включи Message Content Intent в Developer Portal
# MESSAGE_CONTENT_INTENT=1
